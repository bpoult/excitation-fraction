<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET Framework app config, shipped next to ExcitationFraction.exe (build.bat copies it).

  Files extracted from a zip downloaded with a browser carry the NTFS "Mark of the Web"
  (Zone.Identifier = Internet). The .NET Framework refuses to load managed assemblies with
  that mark unless the host opts in, so pythonnet's Python.Runtime.dll fails to load and
  pywebview dies with "Failed to resolve Python.Runtime.Loader.Initialize". This opt-in
  applies only to this executable.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
